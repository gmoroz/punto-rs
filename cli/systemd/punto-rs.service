[Unit]
Description=punto-rs — исправление раскладки набранного текста
Documentation=https://github.com/gmoroz/punto-rs
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/punto-rs
ExecStartPre=%h/.local/bin/punto-rs --check-config
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=2
UMask=0077
LimitCORE=0

# Доступ к /dev/input/* и /dev/uinput даёт группа input. Опции с user namespace
# (PrivateUsers, ProtectSystem и т.п.) не подходят: в namespace группа input
# не отображается, и устройства перестают открываться.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=64M

[Install]
WantedBy=graphical-session.target
